{
  "name": "cine-madrid-tmdb",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "vars": {"ALLOWED_ORIGIN": "https://ignaciogarijo.github.io", "PUBLIC_FAVORITES": "true"},
  "ratelimits": [
    {"name":"SEARCH_RATE_LIMITER","namespace_id":"1001","simple":{"limit":30,"period":60}},
    {"name":"AUTH_RATE_LIMITER","namespace_id":"1002","simple":{"limit":5,"period":60}}
  ],
  "durable_objects": {"bindings":[{"name":"FAVORITES","class_name":"Favorites"}]},
  "migrations": [{"tag":"favorites-v1","new_sqlite_classes":["Favorites"]}]
}
